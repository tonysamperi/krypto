{
  "include": [
    "src"
  ],
  "exclude": [
    "test",
    "src/crypto-js.ts"
  ],
  "compilerOptions": {
    "module": "CommonJS",
    "target": "es6",
    "lib": [
      "esnext",
      "dom"
    ],
    "allowJs": true,
    "importHelpers": false,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "types": ["jest"],
    "esModuleInterop": true,
    "outDir": "dist"
  }
}
