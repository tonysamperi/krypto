{
  "name": "@tonysamperi/krypto",
  "version": "1.2.0",
  "author": "Tony Samperi",
  "description": "Modern tree-shakeable TypeScript version of crypto-js",
  "type": "module",
  "types": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "unpkg": "./dist/cjs/index.cjs",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "!dist/raw-esm",
    "!dist/raw-types",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && NODE_ENV=production node build.config.js",
    "clean": "rimraf dist",
    "lint": "eslint && tsc --noEmit",
    "lint:fix": "eslint --fix",
    "publish:beta": "npm publish --tag beta",
    "publish:next": "npm publish --tag next",
    "test": "jest"
  },
  "homepage": "https://tonysamperi.github.io/crypto/",
  "license": "MIT",
  "keywords": [
    "crypto-js",
    "typescript",
    "sync-crypto",
    "crypto-ts",
    "crypto"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonysamperi/crypto.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fast-glob": "^3.3.3",
    "jest": "^30.5.2",
    "replace-in-file": "^9.0.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "optionalDependencies": {
    "@types/crypto-js": "^4",
    "crypto-js": "^4.2.0"
  },
  "packageManager": "yarn@4.7.0"
}
